DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=success_budget
DB_PASSWORD=change-me
DB_DATABASE=success_budget

JWT_SECRET=change-me

# Optional. Controls pino's log level (fatal/error/warn/info/debug/trace/silent).
# Defaults to info if unset.
LOG_LEVEL=info

# Optional. Logs are plain JSON unless this is exactly "development", in
# which case they're pretty-printed for a terminal via pino-pretty (a
# devDependency, never loaded otherwise - if unset, you get safe JSON, not
# a crash from a missing package).
NODE_ENV=development
