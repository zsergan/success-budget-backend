DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=success_budget
DB_PASSWORD=change-me
DB_DATABASE=success_budget

# Optional. Set DB_SSL=true for a managed MySQL that requires TLS (most
# hosted providers) - the app, migrations, and scripts/db-backup.sh /
# scripts/db-restore.sh all honor this the same way. DB_SSL_CA can be a
# file path or the raw PEM contents of the provider's CA certificate;
# without it, the default trusted CA bundle is used, which is enough for a
# provider using a publicly-trusted cert. A provider using its own/
# self-signed CA needs DB_SSL_CA set to that CA's certificate - that keeps
# verification on and trusts the right issuer, rather than turning
# verification off. DB_SSL_REJECT_UNAUTHORIZED defaults to true; only set
# it to false as a last resort when that CA genuinely cannot be obtained,
# understanding that this disables certificate validation entirely.
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change-me

# Optional. Controls pino's log level (fatal/error/warn/info/debug/trace/silent).
# Defaults to info if unset.
LOG_LEVEL=info

# Only two values change behavior: "development" (pretty-printed logs via
# pino-pretty, a devDependency never loaded otherwise) and "production"
# (disables Swagger by default - see SWAGGER_ENABLED below). Anything else,
# including unset, behaves like plain JSON logs + Swagger enabled - so a
# literal "staging" value here does NOT get you production's Swagger
# default. Staging and production deployments must set this to exactly
# "production" (see docs/deployment.md#environments) - never leave it unset
# there, since that silently leaves Swagger exposed.
NODE_ENV=development

# Optional. Port the HTTP server listens on. Defaults to 3000 - most hosting
# platforms inject their own PORT value, which this picks up automatically.
PORT=3000

# Optional. Express's `trust proxy` setting - controls how the app derives a
# request's real client IP (used by rate limiting) from X-Forwarded-For.
# Left unset, no forwarded header is trusted at all (safe default: a client
# can't spoof its own rate-limit identity). Set to the number of reverse
# proxy hops in front of the app (usually "1" for a typical single-proxy
# PaaS host) once you know your hosting provider's setup - see README.
# TRUST_PROXY=1

# Optional. Enables Swagger UI at /docs. Defaults to enabled everywhere
# except when NODE_ENV=production, where it's disabled unless set to "true"
# here explicitly. Since staging also sets NODE_ENV=production (see above),
# this is off by default on staging too - set it to "true" there if staging
# needs an interactive Swagger UI.
# SWAGGER_ENABLED=true

# SMTP settings for confirmation-code emails. These point at the local
# MailDev catcher started by docker-compose.yml (no auth needed) - open
# http://localhost:1080 to see caught emails instead of a real inbox. For a
# real provider, fill in SMTP_USER/SMTP_PASSWORD and set SMTP_SECURE=true if
# it requires TLS.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Success Budget <no-reply@success-budget.local>"
